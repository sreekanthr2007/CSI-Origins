# ==============================================================================
# TRACE Production Environment Variables Template
# Cross-Bank Mule Account Detection Network
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=TRACE
API_PREFIX=/api/v1

# Security & CORS Configuration
# Set to your production domains (e.g., https://trace.fiuindia.gov.in)
CORS_ORIGINS=["https://trace.internal.network", "https://central.trace.bank", "http://localhost:80"]

# Database Configuration
# Use PostgreSQL for high-concurrency production deployments
DATABASE_URL=sqlite:////app/backend/data/mule_network.db
# DATABASE_URL=postgresql://trace_user:trace_secure_password_2026@postgres:5432/trace_mule_detection
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cryptographic Keys (MUST BE ROTATED AND SECURED IN HSM/VAULT)
# Generate 64-character hex strings: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_STANDING_KEY=9e8c7b6a5d4c3b2a1f0e9d8c7b6a5d4c3b2a1f0e9d8c7b6a5d4c3b2a1f0e9d8c
EPHEMERAL_KEY_SECRET=f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f00
KEY_ROTATION_DAYS=30
SALT_EXPIRY_HOURS=24

# Flow A Continuous Detection Parameters
PASS_THROUGH_THRESHOLD=0.85
RAPID_HOP_MAX_MINUTES=90
STRUCTURING_TOLERANCE=5000.0
INDIAN_PAN_THRESHOLD=50000.0
FLOW_A_CYCLE_HOURS=24
CYCLE_WINDOW_DAYS=7

# Flow B Targeted Investigation Parameters
MAX_INVESTIGATION_DEPTH=4
ALPHA_PASS_THROUGH_WEIGHT=0.60
BETA_DWELL_TIME_WEIGHT=0.40
DECAY_TERMINATION_THRESHOLD=0.35
MAX_HOPS_PER_INVESTIGATION=5

# Bank Node Integration & Alerting
ALERT_RETRY_ATTEMPTS=3
ALERT_RETRY_BACKOFF_SECONDS=0.5
REGULATORY_AGENCY_NAME=Financial Intelligence Unit - India (FIU-IND)
PMLA_MANDATE_SECTION=Section 12, Prevention of Money Laundering Act 2002

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
